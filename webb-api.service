# File path: /etc/systemd/system/webb-api.service
# sudo systemctl daemon-reload
# sudo systemctl start webb-api
# sudo systemctl enable webb-api
# sudo systemctl status webb-api
[Unit]
Description=Webb API Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/webb-api  # 注意修改路径
ExecStart=/path/to/webb-api/webb-api --port 3000 --log-dir /path/to/webb-api/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
